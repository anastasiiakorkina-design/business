# ============================================================
# ENTREPRENEUR COACHING — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ============================================================

# ---- App -------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Elite Entrepreneur Coaching"
NEXT_PUBLIC_APP_DESCRIPTION="Transform your business with world-class coaching"

# ---- Database --------------------------------------------------
# PostgreSQL via Neon, Supabase, Railway, or self-hosted
DATABASE_URL="postgresql://user:password@localhost:5432/entrepreneur_coaching?schema=public"
# Optional: shadow database for Prisma migrations in production
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/entrepreneur_coaching_shadow?schema=public"

# ---- NextAuth v5 -----------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET="your-super-secret-key-min-32-chars"
# Must match NEXT_PUBLIC_APP_URL in production
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.developers.google.com/)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID="your-github-oauth-app-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-secret"

# ---- Stripe ----------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret from Stripe dashboard or `stripe listen --forward-to`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Product / price IDs from Stripe dashboard
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_GROWTH_MONTHLY="price_..."
STRIPE_PRICE_GROWTH_ANNUAL="price_..."
STRIPE_PRICE_ELITE_MONTHLY="price_..."
STRIPE_PRICE_ELITE_ANNUAL="price_..."
STRIPE_PRICE_VIP_DAY="price_..."

# ---- Email (SMTP) ----------------------------------------------
# Use Resend, SendGrid, Postmark, or any SMTP
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="resend"
SMTP_PASSWORD="re_..."
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_REPLY_TO="hello@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"

# ---- Cloudinary (media uploads) --------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="entrepreneur_coaching"

# ---- Analytics -------------------------------------------------
# Vercel Analytics (auto-detected on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# PostHog (optional, product analytics)
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---- Calendly (booking integration) ----------------------------
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-username"
NEXT_PUBLIC_CALENDLY_DISCOVERY_CALL_URL="https://calendly.com/your-username/discovery-call"
NEXT_PUBLIC_CALENDLY_STRATEGY_SESSION_URL="https://calendly.com/your-username/strategy-session"

# ---- Notion (optional blog CMS) --------------------------------
NOTION_API_KEY="secret_..."
NOTION_BLOG_DATABASE_ID="..."

# ---- Upstash Redis (rate limiting, sessions) -------------------
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ---- Feature flags --------------------------------------------
NEXT_PUBLIC_ENABLE_BLOG="true"
NEXT_PUBLIC_ENABLE_BOOKING="true"
NEXT_PUBLIC_ENABLE_STORE="false"
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# ---- Security -------------------------------------------------
# Comma-separated list of allowed admin emails
ADMIN_EMAILS="admin@yourdomain.com"
# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM="60"

# ---- Vercel ---------------------------------------------------
# Automatically set by Vercel, useful for preview URLs
VERCEL_URL=""
VERCEL_ENV="development"
